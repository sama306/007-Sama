{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
  
      "@lib/*": ["./src/lib/*"],
      "@stores/*": ["./src/stores/*"],
      "@content/*": ["./src/content/*"]
    }
  }
}
