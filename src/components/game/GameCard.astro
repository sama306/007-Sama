---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import WishlistButton from '@components/game/WishlistButton'

export interface Props {
  game: CollectionEntry<'games'>
  userId?: string
}

const { game, userId = 'guest' } = Astro.props
const { data } = game

const discountedPrice =
  data.discount > 0 ? (data.price * (1 - data.discount / 100)).toFixed(2) : null

const stars = Math.round(data.rating)
const emptyStars = 5 - stars

const platformLabels: Record<string, string> = {
  pc: 'PC',
  ps5: 'PS5',
  'xbox-series-x': 'X/S',
  switch: 'Switch',
}
---

<article
  class="game-card card-hover group relative flex flex-col overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)]"
  data-genre={data.genre}
  data-platforms={data.platform.join(',')}
  data-price={data.discount > 0
    ? (data.price * (1 - data.discount / 100)).toFixed(2)
    : data.price.toFixed(2)}
  data-rating={data.rating}
  data-slug={data.slug}
  data-release={data.releaseDate.toISOString()}
>
  <a href={`/games/${data.slug}`} class="flex flex-col">
    <div class="card-image-container relative aspect-[16/9] bg-[var(--color-bg-secondary)]">
      {
        data.images[0] && (
          <Image
            src={data.images[0]}
            alt={data.title}
            class="h-full w-full object-cover"
            width={400}
            height={225}
            loading="lazy"
          />
        )
      }

      <WishlistButton slug={data.slug} userId={userId} title={data.title} client:visible />

      {
        data.discount > 0 && (
          <span class="absolute left-2 top-2 rounded bg-[var(--color-accent-primary)] px-2 py-0.5 text-xs font-bold text-white">
            -{data.discount}%
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-2 p-4">
      <h3 class="text-base font-semibold text-[var(--color-text-primary)] line-clamp-1">
        {data.title}
      </h3>

      <p class="text-xs text-[var(--color-text-muted)] line-clamp-2">
        {data.description}
      </p>

      <div class="mt-auto flex items-center gap-1">
        {
          Array.from({ length: stars }, (_, i) => (
            <svg
              class="h-3.5 w-3.5 text-[var(--color-accent-secondary)]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
        {
          Array.from({ length: emptyStars }, (_, i) => (
            <svg
              class="h-3.5 w-3.5 text-[var(--color-border)]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
        <span class="ml-1 text-xs text-[var(--color-text-muted)]">{data.rating.toFixed(1)}</span>
      </div>

      <div class="flex flex-wrap items-center gap-1.5">
        {
          data.platform.map((p) => (
            <span
              class="rounded border border-[var(--color-border)] px-1.5 py-0.5 text-[10px] font-medium uppercase text-[var(--color-text-muted)]"
            >
              {platformLabels[p] ?? p}
            </span>
          ))
        }
      </div>

      <div class="flex items-baseline gap-2">
        {
          discountedPrice ? (
            <>
              <span class="text-lg font-bold text-[var(--color-accent-primary)]">
                ${discountedPrice}
              </span>
              <span class="text-sm text-[var(--color-text-muted)] line-through">
                ${data.price.toFixed(2)}
              </span>
            </>
          ) : (
            <span class="text-lg font-bold text-[var(--color-text-primary)]">
              ${data.price.toFixed(2)}
            </span>
          )
        }
      </div>
    </div>
  </a>
</article>
