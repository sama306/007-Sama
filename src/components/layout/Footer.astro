---
const year = new Date().getFullYear()
const footerLinks = [
  { href: '/games', label: 'Catálogo' },
  { href: '/new-releases', label: 'Novedades' },
  { href: '/news', label: 'Noticias' },
  { href: '/search', label: 'Buscar' },
]
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
  <div
    class="mx-auto grid max-w-[var(--max-width-content)] grid-cols-1 gap-8 px-6 py-12 sm:grid-cols-3"
  >
    <div>
      <a href="/" class="text-lg font-bold text-[var(--color-text-primary)]">007-Sama</a>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">
        Tu tienda de videojuegos. Proyecto personal sin pagos reales.
      </p>
    </div>

    <div>
      <h3
        class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
      >
        Enlaces
      </h3>
      <ul class="space-y-2">
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3
        class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
      >
        Legal
      </h3>
      <ul class="space-y-2">
        <li>
          <a
            href="/legal/terms"
            class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
          >
            Términos del servicio
          </a>
        </li>
        <li>
          <a
            href="/legal/privacy"
            class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
          >
            Política de privacidad
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)] py-4 text-center">
    <p class="text-xs text-[var(--color-text-muted)]">
      &copy; {year} 007-Sama. Proyecto portfolio — sin transacciones reales.
    </p>
  </div>
</footer>
