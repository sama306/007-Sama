---
import { Image } from 'astro:assets'
import BaseLayout from '@layouts/BaseLayout.astro'
import JsonLd from '@components/seo/JsonLd.astro'
import AddToCartButton from '@components/cart/AddToCartButton'
import WishlistButton from '@components/game/WishlistButton'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => data.status === 'published')
  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }))
}

const userId = Astro.locals.user?.id ?? 'guest'

const { game } = Astro.props as { game: CollectionEntry<'games'> }
const { Content } = await render(game)
const { data } = game

const discountedPrice =
  data.discount > 0 ? (data.price * (1 - data.discount / 100)).toFixed(2) : null

const stars = Math.round(data.rating)
const emptyStars = 5 - stars

const gallery = data.images.slice(1)
const coverImage = data.images[0]

const genreLabels: Record<string, string> = {
  action: 'Acción',
  rpg: 'RPG',
  strategy: 'Estrategia',
  adventure: 'Aventura',
  simulation: 'Simulación',
  sports: 'Deportes',
  horror: 'Terror',
}

const platformLabels: Record<string, string> = {
  pc: 'PC',
  ps5: 'PS5',
  'xbox-series-x': 'Xbox Series X|S',
  switch: 'Nintendo Switch',
}

const platformColors: Record<string, string> = {
  pc: '#6366f1',
  ps5: '#003791',
  'xbox-series-x': '#107c10',
  switch: '#e60012',
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}

const hasGallery = gallery.length > 0
const hasTrailer = Boolean(data.trailerUrl)
const hasRequirements = Boolean(data.requirements)
const hasStores = data.stores.length > 0
---

<BaseLayout title={data.title} description={data.description} image={coverImage} type="product">
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: data.title,
      description: data.description,
      image: coverImage,
      offers: {
        '@type': 'Offer',
        price: discountedPrice ? Number(discountedPrice) : data.price,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      ...(data.rating > 0 && {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: data.rating,
          bestRating: 5,
        },
      }),
    }}
  />
  <article>
    <div class="relative bg-[var(--color-bg-secondary)]">
      <div class="mx-auto max-w-[var(--max-width-content)] px-6 py-12 lg:py-16">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
          <div class="w-full shrink-0 lg:w-96">
            <div
              class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
            >
              {
                coverImage && (
                  <Image
                    src={coverImage}
                    alt={data.title}
                    class="w-full object-cover"
                    width={600}
                    height={900}
                    loading="eager"
                    fetchpriority="high"
                  />
                )
              }
            </div>
          </div>

          <div class="flex flex-1 flex-col gap-4">
            <h1 class="text-3xl font-bold text-[var(--color-text-primary)] lg:text-4xl">
              {data.title}
            </h1>

            <p class="text-base leading-relaxed text-[var(--color-text-secondary)]">
              {data.description}
            </p>

            <div class="flex items-center gap-1">
              {
                Array.from({ length: stars }, (_, i) => (
                  <svg
                    key={i}
                    class="h-5 w-5 text-[var(--color-accent-secondary)]"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))
              }
              {
                Array.from({ length: emptyStars }, (_, i) => (
                  <svg
                    key={i}
                    class="h-5 w-5 text-[var(--color-border)]"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))
              }
              <span class="ml-2 text-sm text-[var(--color-text-muted)]"
                >{data.rating.toFixed(1)} / 5</span
              >
            </div>

            <div class="flex flex-wrap gap-2">
              {
                data.platform.map((p) => (
                  <span
                    key={p}
                    class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold uppercase"
                    style={{
                      backgroundColor: `${platformColors[p]}20`,
                      color: platformColors[p],
                      border: `1px solid ${platformColors[p]}40`,
                    }}
                  >
                    {platformLabels[p]}
                  </span>
                ))
              }
            </div>

            <div class="flex items-baseline gap-3">
              {
                discountedPrice ? (
                  <>
                    <span class="text-3xl font-bold text-[var(--color-accent)]">
                      ${discountedPrice}
                    </span>
                    <span class="text-lg text-[var(--color-text-muted)] line-through">
                      ${data.price.toFixed(2)}
                    </span>
                    <span class="rounded bg-[var(--color-accent-secondary)] px-2 py-0.5 text-xs font-bold text-black">
                      -{data.discount}%
                    </span>
                  </>
                ) : (
                  <span class="text-3xl font-bold text-[var(--color-text-primary)]">
                    ${data.price.toFixed(2)}
                  </span>
                )
              }
            </div>

            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
              <div class="flex-1">
                <AddToCartButton
                  client:visible
                  id={data.slug}
                  slug={data.slug}
                  title={data.title}
                  price={discountedPrice ? Number(discountedPrice) : data.price}
                  image={data.images[0] || ''}
                  platform={data.platform[0] || 'pc'}
                />
              </div>
              <WishlistButton
                client:visible
                slug={data.slug}
                userId={userId}
                title={data.title}
                variant="text"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-[var(--max-width-content)] px-6 py-12">
      <div class="grid gap-12 lg:grid-cols-[1fr_280px]">
        <div class="flex flex-col gap-12">
          <section>
            <h2 class="mb-4 text-2xl font-bold text-[var(--color-text-primary)]">
              Acerca de este juego
            </h2>
            <div
              class="prose prose-invert max-w-none text-[var(--color-text-secondary)] leading-relaxed"
            >
              <Content />
            </div>
          </section>

          {
            hasGallery && (
              <section>
                <h2 class="mb-4 text-2xl font-bold text-[var(--color-text-primary)]">Galería</h2>
                <div class="grid gap-4 sm:grid-cols-2">
                  {gallery.map((img, i) => (
                    <div
                      key={i}
                      class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
                    >
                      <Image
                        src={img}
                        alt={`${data.title} screenshot ${i + 1}`}
                        class="h-full w-full object-cover"
                        width={600}
                        height={338}
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          {
            hasTrailer && (
              <section>
                <h2 class="mb-4 text-2xl font-bold text-[var(--color-text-primary)]">Tráiler</h2>
                <div class="aspect-video overflow-hidden rounded-lg border border-[var(--color-border)]">
                  <iframe
                    src={data.trailerUrl!.replace('watch?v=', 'embed/')}
                    title={`${data.title} tráiler`}
                    class="h-full w-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              </section>
            )
          }

          {
            hasRequirements && (
              <section>
                <h2 class="mb-4 text-2xl font-bold text-[var(--color-text-primary)]">
                  Requisitos del sistema
                </h2>
                <div class="grid gap-6 sm:grid-cols-2">
                  <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
                    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
                      Mínimo
                    </h3>
                    <ul class="space-y-1.5 text-sm text-[var(--color-text-secondary)]">
                      {data.requirements!.minimum.map((req) => (
                        <li class="flex gap-2">
                          <span class="shrink-0 text-[var(--color-accent)]">&bull;</span>
                          <span>{req}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  {data.requirements!.recommended && (
                    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
                      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
                        Recomendado
                      </h3>
                      <ul class="space-y-1.5 text-sm text-[var(--color-text-secondary)]">
                        {data.requirements!.recommended.map((req) => (
                          <li class="flex gap-2">
                            <span class="shrink-0 text-[var(--color-accent)]">&bull;</span>
                            <span>{req}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </section>
            )
          }
        </div>

        <aside class="space-y-6">
          <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
            <h3
              class="mb-4 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
            >
              Información
            </h3>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-[var(--color-text-muted)]">Desarrollador</dt>
                <dd class="text-[var(--color-text-primary)]">{data.developer}</dd>
              </div>
              {
                data.publisher && (
                  <div>
                    <dt class="text-[var(--color-text-muted)]">Editor</dt>
                    <dd class="text-[var(--color-text-primary)]">{data.publisher}</dd>
                  </div>
                )
              }
              <div>
                <dt class="text-[var(--color-text-muted)]">Género</dt>
                <dd class="text-[var(--color-text-primary)]">
                  {genreLabels[data.genre] ?? data.genre}
                </dd>
              </div>
              <div>
                <dt class="text-[var(--color-text-muted)]">Lanzamiento</dt>
                <dd class="text-[var(--color-text-primary)]">{formatDate(data.releaseDate)}</dd>
              </div>
              <div>
                <dt class="text-[var(--color-text-muted)]">Plataformas</dt>
                <dd class="flex flex-wrap gap-1.5 pt-1">
                  {
                    data.platform.map((p) => (
                      <span
                        key={p}
                        class="rounded border border-[var(--color-border)] px-2 py-0.5 text-xs font-medium uppercase text-[var(--color-text-muted)]"
                      >
                        {platformLabels[p]}
                      </span>
                    ))
                  }
                </dd>
              </div>
            </dl>
          </div>

          {
            data.tags.length > 0 && (
              <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]">
                  Etiquetas
                </h3>
                <div class="flex flex-wrap gap-2">
                  {data.tags.map((tag) => (
                    <span
                      key={tag}
                      class="rounded border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          {
            hasStores && (
              <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]">
                  Dónde comprar
                </h3>
                <div class="flex flex-col gap-2">
                  {data.stores.map((store) => (
                    <a
                      key={store.label}
                      href={store.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-4 py-2 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
                    >
                      {store.label}
                      <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
