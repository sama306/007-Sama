---
import BaseLayout from '@layouts/BaseLayout.astro'
import CheckoutSummary from '@components/cart/CheckoutSummary'
import CheckoutForm from '@components/cart/CheckoutForm'

export const prerender = false
---

<BaseLayout
  title="Finalizar Compra"
  description="Completa tu compra simulada en 007-Sama."
  noindex={true}
  type="website"
>
  <section class="mx-auto max-w-[var(--max-width-content)] px-6 py-12">
    <div class="mb-12 flex items-center justify-center gap-2 text-sm font-medium">
      <span class="flex items-center gap-2 text-[var(--color-accent-primary)]">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-accent-primary)] text-xs text-white"
          >✓</span
        >
        Carrito
      </span>
      <span class="h-px w-12 bg-[var(--color-accent-primary)]"></span>
      <span class="flex items-center gap-2 text-[var(--color-accent-primary)]">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-accent-primary)] text-xs text-white"
          >2</span
        >
        Checkout
      </span>
      <span class="h-px w-12 bg-[var(--color-border)]"></span>
      <span class="flex items-center gap-2 text-[var(--color-text-muted)]">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-full border border-[var(--color-border)] text-xs"
          >3</span
        >
        Confirmación
      </span>
    </div>

    <div class="lg:grid lg:grid-cols-[1fr_28rem] lg:gap-10">
      <div>
        <CheckoutForm client:load />
      </div>
      <aside class="mt-8 lg:mt-0">
        <CheckoutSummary client:visible />
      </aside>
    </div>
  </section>
</BaseLayout>
