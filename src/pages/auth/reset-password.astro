---
export const prerender = false

import BaseLayout from '@layouts/BaseLayout.astro'
import ResetPasswordForm from '@components/auth/ResetPasswordForm'
import { validateResetToken } from '@lib/tokens'

const token = Astro.url.searchParams.get('token')

if (!token) {
  return Astro.redirect('/auth/forgot-password')
}

const validation = validateResetToken(token)
---

<BaseLayout
  title="Restablecer Contraseña"
  description="Establece una nueva contraseña para tu cuenta en 007-Sama."
  noindex={true}
>
  <div
    class="flex min-h-[calc(100dvh-var(--header-height))] items-center justify-center px-4 py-12"
  >
    <div class="w-full max-w-md">
      <div class="animate-fade-in-up text-center">
        <a
          href="/"
          class="inline-block text-3xl font-bold text-[var(--color-accent-neon)]"
          aria-label="007-Sama inicio"
        >
          007-Sama
        </a>
        <h1 class="mt-6 text-2xl font-bold text-[var(--color-text-primary)]">
          Restablecer contraseña
        </h1>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
          Elegí una contraseña nueva para tu cuenta.
        </p>
      </div>

      <div class="animate-fade-in-up mt-8" style="animation-delay: 0.1s">
        {
          validation.valid ? (
            <ResetPasswordForm client:load token={token} />
          ) : (
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-8 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-500/10">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-error)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
              </div>
              <h2 class="text-lg font-bold text-[var(--color-text-primary)]">
                Link inválido o expirado
              </h2>
              <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
                Este link es inválido o ya expiró. Solicitá uno nuevo para restablecer tu
                contraseña.
              </p>
              <a
                href="/auth/forgot-password"
                class="mt-6 inline-flex items-center justify-center rounded-lg bg-[var(--color-accent-primary)] px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-[var(--color-accent-secondary)] hover:shadow-[0_0_20px_var(--color-accent-glow)]"
              >
                Solicitar nuevo link
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
