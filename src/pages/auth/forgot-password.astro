---
export const prerender = false

import BaseLayout from '@layouts/BaseLayout.astro'
import ForgotPasswordForm from '@components/auth/ForgotPasswordForm'

const { user } = Astro.locals

if (user) {
  return Astro.redirect('/account')
}
---

<BaseLayout title="Recuperar Contraseña" description="Recupera el acceso a tu cuenta en 007-Sama." noindex={true}>
  <div class="flex min-h-[calc(100dvh-var(--header-height))] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="animate-fade-in-up text-center">
        <a href="/" class="inline-block text-3xl font-bold text-[var(--color-accent-neon)]" aria-label="007-Sama inicio">
          007-Sama
        </a>
        <h1 class="mt-6 text-2xl font-bold text-[var(--color-text-primary)]">
          Recuperar contraseña
        </h1>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
          Ingresá tu email y te enviaremos instrucciones para restablecer tu contraseña.
        </p>
      </div>

      <div class="animate-fade-in-up mt-8" style="animation-delay: 0.1s">
        <ForgotPasswordForm client:load />
      </div>
    </div>
  </div>
</BaseLayout>
