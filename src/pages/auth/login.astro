---
export const prerender = false

import BaseLayout from '@layouts/BaseLayout.astro'
import LoginForm from '@components/auth/LoginForm'

const { user } = Astro.locals

if (user) {
  return Astro.redirect('/account')
}

const redirect = Astro.url.searchParams.get('redirect') || '/'
const error = Astro.url.searchParams.get('error') || ''
---

<BaseLayout title="Iniciar Sesión" description="Accede a tu cuenta en 007-Sama." noindex={true}>
  <div
    class="flex min-h-[calc(100dvh-var(--header-height))] items-center justify-center px-4 py-12"
  >
    <div class="w-full max-w-md">
      <div class="animate-fade-in-up text-center">
        <a
          href="/"
          class="inline-block text-3xl font-bold text-[var(--color-accent-neon)]"
          aria-label="007-Sama inicio"
        >
          007-Sama
        </a>
        <h1 class="mt-6 text-2xl font-bold text-[var(--color-text-primary)]">Iniciar sesión</h1>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
          Accedé a tu cuenta para gestionar compras y favoritos.
        </p>
      </div>

      <div class="animate-fade-in-up mt-8" style="animation-delay: 0.1s">
        <LoginForm client:load redirect={redirect} error={error} />
      </div>
    </div>
  </div>
</BaseLayout>
