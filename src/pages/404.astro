---
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe."
  noindex={true}
>
  <div
    class="flex min-h-[calc(100dvh-var(--header-height))] flex-col items-center justify-center px-6 py-24 text-center"
  >
    <span class="mb-4 text-8xl font-bold text-[var(--color-accent-primary)]">404</span>
    <h1 class="mb-3 text-2xl font-bold text-[var(--color-text-primary)]">Página no encontrada</h1>
    <p class="mb-8 max-w-md text-sm text-[var(--color-text-secondary)]">
      La página que estás buscando no existe o fue movida. Revisá la URL o volvé al inicio.
    </p>
    <a
      href="/"
      class="inline-block rounded-lg bg-[var(--color-accent-primary)] px-8 py-3 text-sm font-semibold text-white transition-all hover:bg-[var(--color-accent-secondary)] hover:shadow-[0_0_20px_var(--color-accent-glow)]"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>
