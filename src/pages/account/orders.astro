---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import OrdersList from '@components/cart/OrdersList';

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect('/auth/login?redirect=/account/orders');
}

const userId = user.id;
---

<BaseLayout title="Mis Pedidos" description="Historial de pedidos simulados en 007-Sama." noindex={true}>
  <div class="mx-auto flex min-h-[calc(100dvh-var(--header-height))] max-w-[var(--max-width-content)] px-6 py-8">
    <aside class="hidden w-64 shrink-0 md:block">
      <nav class="sticky top-24 space-y-1">
        <a href="/account" class="flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-text-primary)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          Perfil
        </a>
        <a href="/account/orders" class="flex items-center gap-3 rounded-lg bg-[var(--color-accent-primary)]/10 px-4 py-2.5 text-sm font-medium text-[var(--color-accent-neon)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <path d="M16 10a4 4 0 0 1-8 0" />
          </svg>
          Mis pedidos
        </a>
        <a href="/account/wishlist" class="flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-text-primary)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          Lista de deseos
        </a>
        <hr class="my-3 border-[var(--color-border)]" />
        <a href="/api/auth/signout" class="flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-error)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          Cerrar sesión
        </a>
      </nav>
    </aside>

    <div class="min-w-0 flex-1 md:ml-10">
      <div class="animate-fade-in-up">
        <OrdersList client:visible userId={userId} />
      </div>
    </div>
  </div>
</BaseLayout>
