---
import BaseLayout from '@layouts/BaseLayout.astro'
import CartPageItems from '@components/cart/CartPageItems'
import CartSummary from '@components/cart/CartSummary'

export const prerender = true
---

<BaseLayout
  title="Carrito de Compras"
  description="Revisa los juegos en tu carrito de compras en 007-Sama."
  noindex={true}
>
  <section class="mx-auto max-w-[var(--max-width-content)] px-6 py-12">
    <h1 class="animate-fade-in-up mb-8 text-3xl font-bold text-[var(--color-text-primary)]">
      Tu carrito
    </h1>

    <div class="lg:grid lg:grid-cols-[1fr_28rem] lg:gap-10">
      <div class="animate-fade-in-up reveal stagger-children">
        <CartPageItems client:visible />
      </div>

      <aside class="animate-fade-in-up mt-8 lg:mt-0" style="animation-delay: 0.15s">
        <CartSummary client:visible />
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .reveal {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }
</style>
