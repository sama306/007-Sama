---
import { Image } from 'astro:assets'
import BaseLayout from '@layouts/BaseLayout.astro'
import JsonLd from '@components/seo/JsonLd.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const articles = await getCollection('news', ({ data }) => data.status === 'published')
  return articles.map((article) => ({
    params: { slug: article.data.slug },
  }))
}

const { slug } = Astro.params
const [article] = await getCollection(
  'news',
  ({ data }) => data.slug === slug && data.status === 'published',
)

const { Content } = await render(article)
const { title, date, author, category, excerpt, image, imageAlt, tags } = article.data
const siteUrl = 'https://007-sama.vercel.app'
const articleUrl = `${siteUrl}/news/${slug}`
const categoryLabels: Record<string, string> = {
  lanzamientos: 'Lanzamientos',
  review: 'Review',
  eventos: 'Eventos',
  ofertas: 'Ofertas',
  industria: 'Industria',
  tutoriales: 'Tutoriales',
  opinion: 'Opinión',
}
---

<BaseLayout title={title} description={excerpt} image={image} type="article">
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: excerpt,
      image,
      datePublished: date.toISOString(),
      dateModified: date.toISOString(),
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: '007-Sama',
        url: siteUrl,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': articleUrl,
      },
      articleSection: categoryLabels[category] ?? category,
      keywords: tags.join(', '),
    }}
  />

  <div class="mx-auto max-w-[var(--max-width-content)] px-6 py-12">
    <nav class="mb-6 text-sm text-[var(--color-text-muted)]">
      <a href="/" class="hover:text-[var(--color-accent)]">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/news" class="hover:text-[var(--color-accent)]">Noticias</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-text-secondary)]">{title}</span>
    </nav>

    <article class="mx-auto max-w-3xl">
      <header class="mb-8">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="rounded bg-[var(--color-accent-secondary)] px-2.5 py-0.5 text-xs font-bold text-black"
          >
            {categoryLabels[category] ?? category}
          </span>
          <time datetime={date.toISOString()} class="text-sm text-[var(--color-text-muted)]">
            {date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>

        <h1
          class="mb-4 text-3xl font-bold leading-tight text-[var(--color-text-primary)] sm:text-4xl"
        >
          {title}
        </h1>

        <p class="mb-4 text-lg text-[var(--color-text-secondary)]">
          {excerpt}
        </p>

        <div class="text-sm text-[var(--color-text-muted)]">
          por <span class="font-medium text-[var(--color-text-primary)]">{author}</span>
        </div>
      </header>

      <div class="relative mb-8 overflow-hidden rounded-xl bg-[var(--color-surface)]">
        <Image
          src={image}
          alt={imageAlt || title}
          class="w-full object-cover"
          width={1200}
          height={630}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div
        class="prose prose-sm prose-invert max-w-none text-[var(--color-text-secondary)] [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-[var(--color-text-primary)] [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-[var(--color-text-primary)] [&_p]:mb-4 [&_p]:leading-relaxed [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--color-accent)] [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-[var(--color-text-muted)] [&_strong]:font-semibold [&_strong]:text-[var(--color-text-primary)] [&_a]:text-[var(--color-accent)] [&_a]:underline [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-1"
      >
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-2 border-t border-[var(--color-border)] pt-6">
            {tags.map((tag) => (
              <span class="rounded border border-[var(--color-border)] bg-[var(--color-bg-card)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </article>
  </div>
</BaseLayout>
